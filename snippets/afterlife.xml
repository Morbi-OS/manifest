<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- afterlife -->
  <remote  name="afl"
           fetch="https://github.com/Morbi-OS"
           revision="15" />

  <remote  name="afl-gitlab"
           fetch="https://gitlab.com/RdW-afk" />

  <remote  name="afl-giteax"
           fetch="https://gitea.com/romeo21" 
           revision="15" />

  <remote  name="afl-gitea"
           fetch="https://gitea.com/AfterlifeOS" 
           revision="15" />

  <!-- art -->
  <project path="art" name="art" groups="pdk" remote="afl" />

  <!-- bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="afl" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="afl" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="afl" />

  <!-- build -->
  <project path="build/make" name="build_make" groups="pdk,sysui-studio" remote="afl" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/release" name="build_release" groups="pdk,tradefed" remote="afl" />
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="afl" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- external -->
  <project path="external/skia" name="external_skia" groups="pdk,qcom_msm8x26" remote="afl" />
  <project path="external/robolectric" name="external/robolectric" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="afl" />

  <!-- frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="afl" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="afl-giteax" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="afl" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="afl" />

  <!-- hardware -->
  <project path="hardware/google/pixel-sepolicy" name="hardware_google_pixel-sepolicy" groups="generic_fs,pixel" remote="afl" />

  <!-- manifest -->
  <project path="manifest" name="manifest" remote="afl" />

  <!-- packages -->
  <project path="packages/apps/AfterHome" name="packages_apps_AfterHome" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="afl" />
  <project path="packages/apps/AfterLab" name="packages_apps_AfterLab" remote="afl" />
  <project path="packages/apps/BtHelper" name="packages_apps_BtHelper" remote="afl" />
  <project path="packages/apps/FaceUnlock" name="packages_apps_FaceUnlock" remote="afl-gitlab" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="afl" />
  <project path="packages/apps/ThemePicker" name="packages_apps_ThemePicker" groups="pdk-fs,sysui-studio" remote="afl" />
  <project path="packages/apps/WallpaperPicker2" name="packages_apps_WallpaperPicker2" groups="pdk-fs,sysui-studio" remote="afl" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk-cw-fs,pdk-fs" remote="afl-gitea" />
  <project path="packages/overlays/Themes" name="packages_overlays_Themes" remote="afl" />
  <project path="packages/services/Telecomm" name="packages_services_Telecomm" groups="pdk-cw-fs,pdk-fs" remote="afl" />

  <!-- sepolicy -->
  <project path="device/lineage/sepolicy" name="device_afterlife_sepolicy" remote="afl" />
  <project path="device/mediatek/sepolicy_vndr" name="device_mediatek_sepolicy_vndr" remote="afl" />

  <!-- system -->
  <project path="system/core" name="system_core" groups="pdk" remote="afl-gitea" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="afl" />
  <project path="system/update_engine" name="system_update_engine" groups="pdk" remote="afl" />

  <!-- vendor -->
  <project path="vendor/afterlife" name="vendor_afterlife" remote="afl" />
  <project path="vendor/certification" name="vendor_certification" remote="afl" />
  <project path="vendor/gms" name="vendor_gms_15" remote="afl-gitlab" clone-depth="1" />
  <project path="vendor/support" name="vendor_support" remote="afl" />

</manifest>